<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PackageId>IBeam.Management.Host</PackageId>
    <AssemblyName>IBeam.Management.Host</AssemblyName>
    <IBeamVersion Condition="'$(IBeamVersion)' == ''">2.17.0</IBeamVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="IBeam.Management.Api" Version="$(IBeamVersion)" />
    <PackageReference Include="IBeam.Management.Identity.Api" Version="$(IBeamVersion)" />
    <PackageReference Include="IBeam.Management.Repositories.AzureTable" Version="$(IBeamVersion)" />
    <PackageReference Include="IBeam.Management.Secrets.AzureKeyVault" Version="$(IBeamVersion)" />
    <PackageReference Include="IBeam.Identity.Api" Version="$(IBeamVersion)" />
    <PackageReference Include="IBeam.Management.Identity.Target.Api" Version="$(IBeamVersion)" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>
</Project>
