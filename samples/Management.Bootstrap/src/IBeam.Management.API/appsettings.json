{
  "ManagementHost": {
    "OrganizationName": "IBeam Support",
    "Storage": { "TablePrefix": "Management" },
    "Secrets": { "Provider": "KeyVault" },
    "Mail": { "Provider": "Smtp" },
    "Cors": { "AllowedOrigins": [] }
  },
  "IBeam": {
    "Management": {
      "Identity": {
        "BootstrapEnabled": false,
        "Storage": { "Mode": "Separate", "TablePrefix": "Management", "ProvisionSchema": false },
        "Jwt": { "Issuer": "IBeam.Management.Identity", "Audience": "ibeam-management", "AccessTokenMinutes": 10, "SessionInactivityMinutes": 30, "SessionAbsoluteLifetimeDays": 1 },
        "Otp": { "CodeLength": 6, "MaxAttempts": 5 },
        "LoginAttempts": { "Enabled": true },
        "Invites": { "Links": { "AllowedOrigins": [], "DefaultAcceptUrl": "" } }
      },
      "Connections": { "ApprovedOrigins": [], "TimeoutSeconds": 10 },
      "PortalDiagnostics": { "TimeoutSeconds": 10, "TokenLifetimeMinutes": 15, "MaximumResponseBytes": 262144 },
      "Audit": { "RetentionDays": 90, "WriteTimeoutSeconds": 5, "FailOnWriteError": true }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Azure": "None", "Microsoft.AspNetCore.DataProtection": "Error" } },
  "AllowedHosts": "*"
}
